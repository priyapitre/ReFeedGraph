# Copy to .env and load it into your shell; the CLI does not auto-load .env.
OPENAI_API_KEY=replace-with-your-key
# Optional OpenAI-compatible chat endpoint:
# OPENAI_BASE_URL=https://your-provider.example/v1
# Embedding calls use a separate endpoint, defaulting to OpenAI:
# EMBEDDING_API_KEY=replace-with-your-embedding-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Root containing DebateArt_data/, BP_data/, and iq2_data/:
# REFEEDGRAPH_DATA_ROOT=data/raw
